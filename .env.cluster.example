# Copy this file to .env.cluster and fill in your real values.
# .env.cluster is ignored by Git because it can contain API keys.

OPENAI_API_KEY=your_openai_key_here
MP_API_KEY=your_materials_project_key_here

# SSH alias from ~/.ssh/config, or user@hostname.
CLUSTER_AGENT_SSH_TARGET=expanse

# Use a remote path where your cluster account has write permission.
CLUSTER_AGENT_REMOTE_ROOT=/scratch/your_real_user/qe_jobs

CLUSTER_AGENT_MODEL=gpt-4o
CLUSTER_AGENT_BACKEND=openai
CLUSTER_AGENT_WORK_DIR=tmp

CLUSTER_AGENT_POLL_SECONDS=30
TRITONDFT_SLURM_TEMPLATE=~/.tritondft/example_slurm_job_file.txt

# Leave empty when module load quantum-espresso exposes pw.x on PATH.
CLUSTER_AGENT_REMOTE_QE_BIN_DIR=

# Optional but recommended when using version-sensitive features such as DFT+U.
# Example: 6.7MaX or 7.3.1. Remote parser probes still verify generated inputs.
CLUSTER_AGENT_QE_VERSION=

# true means Materials Project lookup is disabled.
# Set to false if you want the agent to use MP_API_KEY.
CLUSTER_AGENT_NO_QUERY_INFO=true
